WEB_ORIGIN=http://localhost:3000 # Default: http://localhost:3000, for allow all origins use '*'
SOCKET_URL=http://localhost:3001 # Default: http://localhost:3001
# CONFIG_PATH=/path/to/config    # Default: config/ in the repo (/app/config in Docker)

# Manager login: "password" (default, uses managerPassword from config/game.json),
# "oidc" (single sign-on only) or "both". OIDC users get their own quiz and results
# folders and can create API keys. See the README for the Pocket ID setup.
MANAGER_AUTH=password
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          # Leave empty for a public (PKCE-only) client
# OIDC_REDIRECT_URI=           # Default: ${SOCKET_URL}/auth/callback
# OIDC_ALLOWED_GROUPS=         # Comma-separated; empty allows every user of the provider
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Pocket ID # Login button label
